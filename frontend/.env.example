DATABASE_URL=postgresql://postgres.yourproject:password@aws-0-us-east-1.pooler.supabase.com:6543/postgres
# The API also accepts POSTGRES_URL, POSTGRES_PRISMA_URL, or SUPABASE_DB_URL.
FRONTEND_URL=http://localhost:3000

# Supabase project (Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Server-side admin key used by the API routes (service_role / secret key).
SUPABASE_SECRET_KEY=your-service-role-secret-key

# --- Google sign-in -----------------------------------------------------------
# Sign-in uses Supabase Auth's Google provider — no extra app env vars needed.
# To enable it:
#   1. Supabase Dashboard > Authentication > Providers > Google: turn on and
#      paste your Google OAuth client ID + secret.
#   2. Add this redirect URL to the Google OAuth client AND to Supabase
#      Authentication > URL Configuration:
#        http://localhost:3000/auth/callback   (and your production URL)
